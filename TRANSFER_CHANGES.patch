diff --git a/src/transfer/draw.js b/src/transfer/draw.js
new file mode 100644
index 0000000..9a5f613
--- /dev/null
+++ b/src/transfer/draw.js
@@ -0,0 +1,51 @@
+import { makeRng } from '../core/rng.js';
+import { nearestLevel } from '../core/draw.js';
+import { questionKey } from '../core/questions.js';
+import { structureKey } from './profile.js';
+import { TRANSFER_FAMILIES } from './index.js';
+export const TRANSFER_SECTIONS = ['bto', 'nl', 'll', 'iv', 'ob'];
+export const TRANSFER_TIMING = Object.freeze({ count: 15, totalSeconds: 1200, perItemSeconds: 90 });
+export function presentation(item, rng) {
+  if (item.kind !== 'mcq') return item;
+  const options = rng.shuffle(item.options);
+  return { ...item, options, answerIndex: options.indexOf(item.options[item.answerIndex]) };
+}
+export function transferItems(modules, { seed, questionHistory = {}, structureHistory = {}, perSection = 3 } = {}) {
+  if (!Number.isInteger(perSection) || perSection < 1 || perSection > 5) throw new Error('perSection must be 1..5');
+  const rng = makeRng(`transfer:${seed}`), out = [];
+  for (const section of TRANSFER_SECTIONS) {
+    const old = modules[section]?.families || [];
+    if (!old.length) throw new Error(`missing section ${section}`);
+    const extras = rng.shuffle(TRANSFER_FAMILIES[section] || []), all = [...old, ...extras];
+    const exactSeen = new Set(questionHistory[section] || []), structureSeen = new Set(structureHistory[section] || []);
+    const runStructures = new Set(), runFamilies = new Set();
+    for (let i = 0; i < perSection; i++) {
+      const allowed = i < extras.length ? [extras[i]] : rng.shuffle(all.filter((f) => !runFamilies.has(f.id)));
+      const pool = allowed.length ? allowed : all;
+      let best = null, bestCost = Infinity;
+      for (let attempt = 0; attempt < 24; attempt++) {
+        const family = pool[attempt % pool.length], difficulty = nearestLevel(family.levels, rng.pick([2, 3, 4]));
+        const item = family.generate(rng.fork(`${section}:${i}:${attempt}:${rng.int(0, 2 ** 30)}`), { difficulty });
+        const key = questionKey(item), structure = structureKey(item), repeat = exactSeen.has(key);
+        const cost = 10000 * Number(repeat) + 100 * Number(runStructures.has(structure)) + 20 * Number(runFamilies.has(family.id)) + 5 * Number(structureSeen.has(structure));
+        if (cost < bestCost) { best = { item, key, structure, repeat }; bestCost = cost; }
+        if (cost === 0) break;
+      }
+      exactSeen.add(best.key); runStructures.add(best.structure); runFamilies.add(best.item.family);
+      const newStructure = !structureSeen.has(best.structure); structureSeen.add(best.structure);
+      out.push({ item: presentation(best.item, rng), key: best.key, structure: best.structure, repeat: best.repeat, newStructure, extended: extras.some((f) => f.id === best.item.family) });
+    }
+  }
+  return rng.shuffle(out);
+}
+export function transferSummary(records) {
+  const summary = (rows) => {
+    const regular = rows.filter((r) => r.section !== 'iv'), intervals = rows.filter((r) => r.section === 'iv');
+    return { displayed: rows.length, answered: rows.filter((r) => !r.skipped).length,
+      regularN: regular.length, regularCorrect: regular.filter((r) => r.correct).length,
+      intervalN: intervals.length, intervalMean: intervals.length ? intervals.reduce((s, r) => s + r.score, 0) / intervals.length : null };
+  };
+  return { all: summary(records), unseen: summary(records.filter((r) => !r.repeat)),
+    newStructure: summary(records.filter((r) => !r.repeat && r.newStructure)),
+    familiarStructure: summary(records.filter((r) => !r.repeat && !r.newStructure)), review: summary(records.filter((r) => r.repeat)) };
+}
diff --git a/src/transfer/families/information-protocols.js b/src/transfer/families/information-protocols.js
new file mode 100644
index 0000000..b9cf781
--- /dev/null
+++ b/src/transfer/families/information-protocols.js
@@ -0,0 +1,69 @@
+// Additional training only: the observation mechanism changes the conditional event.
+import { mcqItem, agree, q, table } from '../../sections/bto/lib.js';
+export const PROTOCOLS = ['first-red', 'any-red', 'random-red', 'noisy-red'];
+const ID = 'information-protocols';
+const fam = {
+  id: ID, section: 'bto', title: 'How was the information obtained?',
+  skill: 'Condition on the actual observation process', levels: [2, 3, 4],
+  generate(rng, { difficulty = 2, variant } = {}) {
+    const protocol = variant || rng.pick(difficulty === 2 ? PROTOCOLS.slice(0, 2) : difficulty === 3 ? PROTOCOLS.slice(0, 3) : PROTOCOLS);
+    if (!PROTOCOLS.includes(protocol)) throw new Error('unknown observation protocol');
+    const r = rng.int(2, 7), b = rng.int(2, 8), n = r + b;
+    const replacement = difficulty === 2 || rng.chance(.5);
+    const sensitivity = rng.pick([70, 80, 90]), falsePositive = rng.pick([10, 20, 30]);
+    const red = q(r, n), both = red.mul(q(r - Number(!replacement), n - Number(!replacement)));
+    const noRed = q(b, n).mul(q(b - Number(!replacement), n - Number(!replacement)));
+    const observed = protocol === 'any-red' ? q(1).sub(noRed) : protocol === 'noisy-red'
+      ? red.mul(q(sensitivity, 100)).add(q(1).sub(red).mul(q(falsePositive, 100))) : red;
+    const numerator = protocol === 'noisy-red' ? both.mul(q(sensitivity, 100)) : both;
+    const value = numerator.div(observed);
+    const notice = {
+      'first-red': 'You are told that the first token drawn is red.',
+      'any-red': 'A checker inspects both tokens and reports "at least one is red" if and only if that is true. You hear that report.',
+      'random-red': 'Without looking at their colours, an observer chooses one of the two drawn tokens uniformly and shows it to you. It is red.',
+      'noisy-red': `Without looking at their colours, a sensor chooses one of the two drawn tokens uniformly. It reports red with probability ${sensitivity}% for a red token and ${falsePositive}% for a blue token, independently of everything else given that token’s colour. It reports red.`,
+    }[protocol];
+    const item = mcqItem(ID, rng, difficulty, {
+      text: `A bag contains ${r} red and ${b} blue tokens. Two tokens are drawn ${replacement ? 'with replacement (return the first before drawing the second)' : 'without replacement'}. ${notice} What is the probability that both drawn tokens are red?`, value,
+      distractors: [
+        { value: both, misconception: 'Ignored the observation and used the unconditional probability.' },
+        { value: red, misconception: 'Used the original red fraction without checking the observation or replacement rule.' },
+        { value: both.div(q(1).sub(noRed)), misconception: 'Conditioned on existence rather than the specified observation mechanism.' },
+        { value: q(1).sub(value), misconception: 'Answered the complement.' },
+        { value: q(1, 2), misconception: 'Treated descriptions of possibilities as equally likely outcomes.' },
+      ],
+      steps: [
+        { say: `Before the report, P(both red) = ${both}.`, why: 'Multiply sequential draw probabilities under the stated replacement rule.' },
+        { say: `P(report) = ${observed}.`, why: protocol === 'any-red' ? 'One minus the probability of two blues.' : protocol === 'noisy-red' ? 'Weight true and false reports by the sampled token’s colour.' : 'A first or uniformly selected token has the original colour marginal.' },
+        { say: `P(both and report)/P(report) = (${numerator})/(${observed}) = ${value}.`, why: protocol === 'noisy-red' ? 'Two reds produce a red report only at the stated sensitivity.' : 'Two reds guarantee this truthful report.' },
+      ],
+      rule: 'P(target | observation) = P(target and observation)/P(observation). Model how information was obtained.',
+      anchor: 'Conditional probability with explicit observation likelihoods.',
+      hints: ['Is the message equally likely for every pair?', 'Compute its probability for each possible colour pair.'],
+      fast: `Joint probability ${numerator}; observation ${observed}; divide: ${value}.`,
+      check: 'Random-token and first-token reports agree by exchangeability; an existence report weights mixed pairs differently.',
+      picture: table(['Quantity', 'Probability'], [['Both red', both], ['Observation', observed], ['Both and observation', numerator]], 'Use the actual report as the conditioning event.'),
+      data: { protocol, replacement, r, b, sensitivity, falsePositive },
+    });
+    item.transfer = { structure: `${replacement ? 'replace' : 'no-replace'}:${protocol}`, operations: protocol === 'noisy-red' ? ['conditioning', 'total-probability', 'observation-error'] : ['conditioning', replacement ? 'independence' : 'dependent-sampling', 'observation-selection'] };
+    return item;
+  },
+  // Independent labelled-token enumeration rather than the aggregate formulas.
+  verify(item) {
+    const p = item.params, n = p.r + p.b; let denominator = 0, numerator = 0;
+    for (let a = 0; a < n; a++) for (let b = 0; b < n; b++) {
+      if (!p.replacement && a === b) continue;
+      const first = a < p.r, second = b < p.r;
+      let weight;
+      if (p.protocol === 'first-red') weight = Number(first);
+      else if (p.protocol === 'any-red') weight = Number(first || second);
+      else { const report = (red) => p.protocol === 'random-red' ? Number(red) : (red ? p.sensitivity : p.falsePositive) / 100; weight = (report(first) + report(second)) / 2; }
+      denominator += weight; if (first && second) numerator += weight;
+    }
+    return agree(item, numerator / denominator);
+  },
+  lesson: { purpose: 'Similar messages can represent different evidence.', anchor: 'Condition on the event observed.',
+    steps: [{ say: 'Model the report.', why: 'Its sampling process determines likelihoods.' }, { say: 'Divide joint by marginal probability.', why: 'This is conditioning.' }],
+    predict: { question: 'Is a random red reveal the same evidence as at least one red?', answer: 'No; mixed pairs receive different report weights.' }, rule: 'Joint target and report divided by report probability.' },
+};
+export default fam;
diff --git a/src/transfer/families/rates-weights.js b/src/transfer/families/rates-weights.js
new file mode 100644
index 0000000..ddb180f
--- /dev/null
+++ b/src/transfer/families/rates-weights.js
@@ -0,0 +1,73 @@
+import { ivItem } from '../../sections/iv/lib.js';
+export const RATE_LEVELS = { 2: ['equal-time', 'mixture', 'reverse-percent'], 3: ['equal-distance', 'compound-change', 'work-together'], 4: ['unequal-distance', 'dilute'] };
+const fam = {
+  id: 'rates-weights', section: 'iv', title: 'Rates, weights and changing bases',
+  skill: 'Determine what is equal or conserved before calculating', levels: [2, 3, 4],
+  generate(rng, { difficulty = 2, variant } = {}) {
+    const scenario = variant || rng.pick(RATE_LEVELS[difficulty]);
+    const v1 = rng.int(3, 7) * 10, v2 = rng.int(8, 12) * 10, d1 = rng.int(2, 5) * 30, d2 = rng.int(6, 9) * 30;
+    const x = rng.int(2, 8) * 10, y = rng.int(2, 8) * 10, a = rng.int(1, 4) * 5, b = rng.int(5, 9) * 5;
+    const base = rng.int(4, 16) * 25, up = rng.pick([10, 20, 25, 40]), down = rng.pick([10, 20, 25, 40]);
+    let text, truth, unit, how, check, params, operations;
+    if (scenario === 'equal-time') {
+      truth = (v1 + v2) / 2; unit = 'km/h'; params = { v1, v2 };
+      text = `A vehicle travels at ${v1} km/h for one hour, then at ${v2} km/h for one hour, with no stop. What is its average speed for the complete journey in km/h?`;
+      how = `Distance ${v1 + v2} km divided by 2 hours gives ${truth}.`; check = 'Equal times give equal speed weights.'; operations = ['rate', 'equal-time-weighting'];
+    } else if (scenario === 'equal-distance' || scenario === 'unequal-distance') {
+      const second = scenario === 'equal-distance' ? d1 : d2;
+      truth = (d1 + second) / (d1 / v1 + second / v2); unit = 'km/h'; params = { v1, v2, d1, d2: second };
+      text = `A vehicle covers ${d1} km at ${v1} km/h, then ${second} km at ${v2} km/h, with no stop. What is its average speed for the complete journey in km/h?`;
+      how = `Total time = ${d1}/${v1} + ${second}/${v2} hours. Speed = ${d1 + second} divided by that time.`;
+      check = 'Use total distance divided by total time; the answer lies between the speeds.'; operations = ['rate', 'reciprocal', scenario === 'equal-distance' ? 'equal-distance-weighting' : 'unequal-distance-weighting'];
+    } else if (scenario === 'mixture') {
+      truth = (x * a + y * b) / (x + y); unit = '%'; params = { x, y, a, b };
+      text = `Mix ${x} litres of a ${a}% salt solution by volume with ${y} litres of a ${b}% solution. Assume volumes add and no salt is lost. What percentage of the mixture is salt?`;
+      how = `Salt = (${x}×${a} + ${y}×${b})/100 litres. Divide by ${x + y} litres and multiply by 100.`;
+      check = 'The result lies between the input percentages, weighted by volume.'; operations = ['weighted-average', 'conservation'];
+    } else if (scenario === 'dilute') {
+      truth = y * (b / a - 1); unit = 'litres'; params = { volume: y, initial: b, target: a };
+      text = `A tank holds ${y} litres of a ${b}% salt solution by volume. How many litres of pure water must be added to reduce it to ${a}%? Assume volumes add and no salt is lost.`;
+      how = `Salt stays ${y}×${b}/100 litres. Required total volume = ${y}×${b}/${a}; subtract ${y}.`;
+      check = 'Water increases total volume but leaves salt amount unchanged.'; operations = ['conservation', 'inverse-proportion', 'solve-equation'];
+    } else if (scenario === 'reverse-percent') {
+      truth = base; unit = 'euros'; params = { final: base * (1 + up / 100), up };
+      text = `After a ${up}% increase, an item costs €${params.final.toFixed(2)}. What was its price in euros before the increase?`;
+      how = `Original × ${1 + up / 100} = ${params.final.toFixed(2)}; divide by ${1 + up / 100}.`;
+      check = 'Apply the increase to recover the displayed final price.'; operations = ['changing-base', 'solve-equation'];
+    } else if (scenario === 'compound-change') {
+      truth = base * (1 + up / 100) * (1 - down / 100); unit = 'euros'; params = { base, up, down };
+      text = `An item costs €${base}. The price rises by ${up}%, then falls by ${down}% of the increased price. What is its final price in euros?`;
+      how = `${base} × ${1 + up / 100} × ${1 - down / 100}.`; check = 'The decrease uses the new base; equal percentage rises and falls do not cancel.'; operations = ['changing-base', 'multiplication'];
+    } else if (scenario === 'work-together') {
+      truth = x * y / (x + y); unit = 'minutes'; params = { x, y };
+      text = `One machine completes a fixed job in ${x} minutes and another in ${y} minutes. At constant rates, working together without interference, how many minutes do they take for one job?`;
+      how = `Combined rate = 1/${x} + 1/${y} jobs per minute; take its reciprocal.`;
+      check = 'Working together must be faster than either machine alone.'; operations = ['rate', 'reciprocal', 'addition'];
+    } else throw new Error('unknown rates scenario');
+    const item = ivItem(fam, rng, difficulty, {
+      text, truth, unit, params: { scenario, ...params },
+      coach: { exact: false, belief: { kind: 'lognormal', sd: .03 }, note: 'The inputs specify the answer. The 3% spread is an illustrative arithmetic allowance; use your own measured errors for interval width.' },
+      steps: [{ say: how, why: check }, { say: `Computed value, rounded for display: ${Number(truth.toPrecision(9))} ${unit}.`, math: `answer ≈ ${Number(truth.toPrecision(9))}`, why: 'Evaluate with consistent units; use extra precision when placing a tight interval.' }],
+      hints: ['What is held equal or conserved?', 'Write the relationship and its units before calculating.'],
+    });
+    item.transfer = { structure: scenario, operations }; return item;
+  },
+  // Check conservation/rate equations instead of repeating the generating expression.
+  verify(item) {
+    const p = item.params, v = item.truth; let residual;
+    if (p.scenario === 'equal-time') residual = 2 * v - p.v1 - p.v2;
+    else if (p.scenario.endsWith('distance')) residual = (p.d1 + p.d2) / v - p.d1 / p.v1 - p.d2 / p.v2;
+    else if (p.scenario === 'mixture') residual = v * (p.x + p.y) - p.x * p.a - p.y * p.b;
+    else if (p.scenario === 'dilute') residual = (p.volume + v) * p.target - p.volume * p.initial;
+    else if (p.scenario === 'reverse-percent') residual = v + v * p.up / 100 - p.final;
+    else if (p.scenario === 'compound-change') { const increased = p.base + p.base * p.up / 100; residual = v - (increased - increased * p.down / 100); }
+    else if (p.scenario === 'work-together') residual = v / p.x + v / p.y - 1;
+    else return { ok: false, detail: 'unknown scenario' };
+    return { ok: Math.abs(residual) < 1e-7, detail: `independent equation residual ${residual}` };
+  },
+  fast: (p) => `Identify the ${p.scenario.replaceAll('-', ' ')} relationship; carry the units.`,
+  lesson: { purpose: 'Changed relationships require different operations.', anchor: 'Use units and conservation to choose an equation.',
+    steps: [{ say: 'Identify the total or conserved quantity.', why: 'It determines the equation.' }, { say: 'Use the correct weights and base.', why: 'An arithmetic average requires equal corresponding weights.' }],
+    predict: { question: 'When may two speeds be averaged arithmetically?', answer: 'Equal times; equal distances require total distance over total time.' }, rule: 'Determine the relationship before calculating.' },
+};
+export default fam;
diff --git a/src/transfer/families/selection-weights.js b/src/transfer/families/selection-weights.js
new file mode 100644
